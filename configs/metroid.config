# HakiOS fragment: the Nothing Phone (3) (metroid) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="metroid"
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
CONFIG_HAKIOS_SOCINFO=y
# CONFIG_HAKIOS_ADRENO is not set
# CONFIG_HAKIOS_HAPTIC is not set
CONFIG_HAKIOS_GOODIX=y
CONFIG_HAKIOS_BUTTONS=y
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# the storage, read only (ufs=2): the partitions U-Boot finds, read through the loader; no darwin partition, so no write
CONFIG_HAKIOS_UFS=y
# CONFIG_HAKIOS_WIFI is not set
CONFIG_TOUCHSCREEN=y
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_FIRMWARE is "device" in the common kernel: say "none" here until this device's firmware is pulled
# the touch screen (drivers/input/hakios.goodix.c) and the keys (drivers/input/hakios.buttons.c): board "metroid"
CONFIG_BOOTARGS="touch_board=metroid buttons_board=metroid"
# all 8 cores: the GIC redistributors 0x40000 apart (platform_metroid, gic_v3_irq.c redistributor-stride).
# The kernel starts on core 0, so the loader is not there during a run: no reads of the storage for the kernel.
# bootcpu=7 keeps core 0 for the loader, but with it only cpus=2 works (14 November): with 4 or more cores the loader
# stops answering at once and the watchdog resets the phone. For the storage: bootcpu=7 cpus=2 ufs_native=1.
CONFIG_CPUS=8
# what chip this is, from SMEM (soc_smem from soc.args): sysctl kern.hakios.soc_*
CONFIG_SOCINFO=y

/*
 * HakiOS's U-Boot on the Nothing Phone (3) (metroid): first light. No keys, no USB and no UFS yet, so no menu and no
 * fastboot: the loader and its payload come from the boot image's ramdisk. If that fails, the reason stays on the
 * screen for 60 s, then the phone resets, and ABL starts Android again (nothing was written).
 */
bootdelay=0
stdout=serial,vidconsole
stderr=serial,vidconsole

bootcmd=hakios info; if hakios load; then hakios boot; fi; echo "HakiOS: nothing started; Android in 60 s"; sleep 60; reset

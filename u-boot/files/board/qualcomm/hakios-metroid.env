/*
 * HakiOS's U-Boot on the Nothing Phone (3) (metroid). UFS is taken over as ABL left it and scanned before the loader
 * starts, so the loader finds the partitions. No keys yet, so no menu: the loader and its payload come from the boot
 * image's ramdisk. If that fails, the reason stays on the
 * screen for 60 s, then the phone resets, and ABL starts Android again (nothing was written).
 */
bootdelay=0
stdout=serial,vidconsole
stderr=serial,vidconsole

bootcmd=echo "HakiOS: scanning the storage (UFS, as ABL left it)..."; scsi scan; echo "HakiOS: storage scan done"; hakios info; if hakios load; then hakios boot; fi; echo "HakiOS: nothing started; Android in 60 s"; sleep 60; reset
